# ── AI (필수) ─────────────────────────────────────────────
# Anthropic API 키. https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# ── NAVER 검색 트렌드 (선택, 권장) ──────────────────────────
# 성별/연령별 검색 관심도 조회 — NAVER API HUB(검색어 트렌드) 키.
# 없으면 데모 시계열로 동작하고 UI에 "DEMO" 배지가 뜹니다.
NAVER_API_HUB_CLIENT_ID=
NAVER_API_HUB_CLIENT_SECRET=

# ── NAVER 이미지 검색 (선택) ────────────────────────────────
# Pinterest 이미지 API 승인 전까지 트렌드 상세의 임시 시각 레퍼런스에 사용합니다.
# 발급: https://developers.naver.com/apps → 애플리케이션 등록 → "검색" API 체크
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── Pinterest (선택) ────────────────────────────────────────
# Pinterest Trends API 접근 토큰. 키워드 성장률만 제공하며, 이미지 검색은
# 별도 승인 범위가 필요합니다(승인 전까지는 검색 딥링크 + NAVER 이미지로 대체).
PINTEREST_ACCESS_TOKEN=

# ── Supabase (선택) ─────────────────────────────────────────
# 없으면 서버 메모리 캐시로만 동작합니다(재시작 시 초기화). raw_search_trend /
# trend_metric 테이블에 실데이터(live)만 append 하려면 채우세요.
# supabase/migrations/0001_init.sql 을 새 프로젝트의 SQL Editor에서 실행하세요.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
